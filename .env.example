# RapidAPI Fallback Configuration for Monochrome / ArkVibe
# Used by lib/stream.ts when Tier 1 Hi-Res proxies return 502/530 or timeout (>2.5s)

# Your RapidAPI key from https://rapidapi.com/
RAPIDAPI_KEY=your_rapidapi_key_here

# RapidAPI Target Provider Host (e.g. spotify-downloader9.p.rapidapi.com or ytstream-download.p.rapidapi.com)
RAPIDAPI_HOST=spotify-downloader9.p.rapidapi.com

# Optional: Override base URL if using a custom gateway
# RAPIDAPI_BASE_URL=https://spotify-downloader9.p.rapidapi.com
